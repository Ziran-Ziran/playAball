extends SceneTree
var checks: int = 0
var failures: int = 0
func _initialize() -> void:
	call_deferred("run")
	create_timer(30).timeout.connect(func(): push_error("Full tuning timeout"); quit(1))
func check(ok: bool, message: String) -> void:
	checks += 1
	if ok: print("PASS: ", message)
	else:
		failures += 1
		push_error(message)
func frames(n: int) -> void:
	for i in n: await physics_frame
func run() -> void:
	check(ResourceLoader.exists("res://scripts/roguelite/lab/full_tuning.gd"), "Full engine catalog is available")
	if not ResourceLoader.exists("res://scripts/roguelite/lab/full_tuning.gd"):
		quit(1)
		return
	var arena = load("res://scenes/roguelite/tuning_run.tscn").instantiate()
	root.add_child(arena)
	await frames(3)
	var tuning = arena.live_tuning
	var full = tuning.full
	check(full.rows.size() > 1000, "Catalog enumerates engine and native/game properties, beyond a curated slider list")
	check(full.find_id("player", "gravity_scale") != "", "Native gravity scale is exposed")
	check(full.find_id("player", "inertia") != "", "Native inertia is exposed")
	check(full.find_id("player", "continuous_cd") != "", "Native CCD enum is exposed")
	check(full.find_id("player", "physics_material_override/friction") != "", "Nested material parameters are exposed")
	check(full.find_id("player", "Shape/shape/radius") != "", "Collision shape resource parameters are exposed")
	check(full.find_id("heavy", "approach_speed") != "", "Enemy archetype parameters are present before any spawn")
	check(full.find_id("boss", "core_hit_points") != "", "Boss parameters are present before boss spawn")
	check(full.find_id("project", "rendering/renderer/rendering_method") != "", "Restart-only engine settings are visible")
	check(full.find_id("upgrade_heavy","weight")!="", "Upgrade resource fields are included")
	check(full.filtered("", "重力").size() > 0 and full.filtered("", "gravity").size() > 0, "Catalog supports Chinese and native-name search")
	print("CATALOG ROWS: ",full.rows.size()," / Project settings: ",full.filtered("工程设置", "").size())
	check(full.filtered("工程设置", "").size()>900, "Project settings include non-editor-tagged settings rather than hiding them")
	var revision: int = arena.director._run_revision
	check(full.set_value(full.find_id("player", "mass"), 1.7), "Native mass can be changed")
	check(full.set_value(full.find_id("player", "speed_limit"), 2100.0), "Speed cap can be changed")
	check(full.set_value(full.find_id("player", "physics_material_override/friction"), 0.4), "Nested friction can be changed")
	await frames(3)
	check(is_equal_approx(arena.player.mass,1.7) and is_equal_approx(arena.player.speed_limit,2100), "Native settings survive following physics frames")
	check(is_equal_approx(arena.player.physics_material_override.friction,0.4), "Quick sliders do not overwrite advanced values")
	check(arena.director._run_revision == revision, "Native tuning does not restart the run")
	full.set_value(full.find_id("heavy", "approach_speed"), 125.0)
	full.set_value(full.find_id("heavy", "hit_points_override"), 9)
	arena.director.spawn_enemy(DemoEnemy.Kind.HEAVY,Vector2(1000,570))
	await frames(3)
	var enemy: DemoEnemy = arena.get_node("Enemies").get_child(0)
	check(enemy.hp == 9 and is_equal_approx(enemy.approach_speed,125), "Future actors receive pre-ready overrides, including initial life")
	full.set_value(full.find_id("heavy", "mass"), 0.9)
	await frames(2)
	check(is_equal_approx(enemy.mass,0.9), "Existing enemy receives native archetype overrides")
	var solver_id: String = full.find_id("space", "SPACE_PARAM_SOLVER_ITERATIONS")
	var original_solver: float = full.current_value(solver_id)
	check(full.set_value(solver_id, 12.0), "Physics server solver can be changed live")
	check(is_equal_approx(PhysicsServer2D.space_get_param(arena.get_world_2d().space,PhysicsServer2D.SPACE_PARAM_SOLVER_ITERATIONS),12), "Solver readback proves real engine application")
	full.reset_value(solver_id)
	check(is_equal_approx(full.current_value(solver_id), original_solver), "Single engine setting resets to its original value")
	var tick_id: String = full.find_id("engine","physics_ticks_per_second")
	var ticks: int = Engine.physics_ticks_per_second
	full.set_value(tick_id, 120)
	check(Engine.physics_ticks_per_second == 120, "Engine physics tick setting is live")
	full.reset_value(tick_id)
	check(Engine.physics_ticks_per_second == ticks, "Engine setting restores without leaking into other scenes")
	var record: Dictionary = full.record()
	full.reset_all()
	check(is_equal_approx(arena.player.mass,1), "Reset-all restores native body baseline")
	check(full.load_record(record), "All advanced overrides round-trip through typed JSON records")
	await frames(2)
	check(is_equal_approx(arena.player.mass,1.7), "Loaded advanced parameters affect the current run")
	check(not full.set_value(full.find_id("player","mass"), -2.0), "Invalid native mass is rejected without causing engine errors")
	check(not full.set_value(full.find_id("player","mass"), INF), "Non-finite native values are rejected")
	check(not full.set_value(full.find_id("camera","zoom"),Vector2.ZERO), "Invalid zero camera zoom is rejected before reaching its engine setter")
	check(not full.set_value(full.find_id("player","max_drag"),8.0), "Invalid launch drag divisor is rejected")
	var unknown: Dictionary = record.duplicate(true)
	unknown["no_such_property"] = 1
	check(not full.load_record(unknown), "Invalid preset is rejected atomically")
	var codec=load("res://scripts/roguelite/lab/tuning_variant.gd")
	check(codec.from_parts(["wrong",1],Vector2.ZERO)==null, "Malformed vector text is rejected before calling engine constructors")
	check(not codec.allowed(Vector2(INF,0)), "Non-finite vector components are rejected")
	var vector_id: String = full.find_id("feedback","particle_gravity")
	check(full.set_value(vector_id,Vector2(0,30)), "Vector2 engine/game parameters can be edited")
	var vector_record: Dictionary = full.record()
	check(full.load_record(vector_record) and arena.feedback.particle_gravity==Vector2(0,30), "Vector parameters survive typed JSON round-trip")
	var shape_id: String = full.find_id("player","Shape/shape/radius")
	check(full.set_value(shape_id,30.0) and is_equal_approx(arena.player.get_node("Shape").shape.radius,30), "Collision resource changes reach the actual shape")
	var fresh=load("res://scenes/roguelite/player_ball.tscn").instantiate()
	check(is_equal_approx(fresh.get_node("Shape").shape.radius,23), "Shape tuning does not modify the shared scene resource")
	fresh.free()
	var color_id: String=full.find_id("player","theme/player_color")
	check(full.set_value(color_id,Color.RED) and arena.player.theme.player_color==Color.RED, "Color resource fields are editable")
	var array_id: String=full.find_id("director","wave_spawn_intervals")
	check(full.set_value(array_id,PackedFloat32Array([6,5,4,3,2])), "Per-wave packed arrays can be edited")
	check(full.load_record(full.record()) and arena.director.wave_spawn_intervals==PackedFloat32Array([6,5,4,3,2]), "Packed arrays retain type through preset serialization")
	var gravity_id: String=full.find_id("project","physics/2d/default_gravity")
	check(full.set_value(gravity_id,200.0), "Global gravity calls its live physics server adapter")
	check(is_equal_approx(float(PhysicsServer2D.area_get_param(arena.get_world_2d().space,PhysicsServer2D.AREA_PARAM_GRAVITY)),200), "World gravity readback confirms actual engine change")
	full.reset_value(gravity_id)
	var directory: String=ProjectSettings.globalize_path("res://.local/full-tuning-cfg-test")
	DirAccess.make_dir_recursive_absolute(directory)
	var config:=ConfigFile.new()
	config.set_value("unrelated","keep",123)
	config.save(directory.path_join("override.cfg"))
	var name_id: String=full.find_id("project","application/config/name")
	full.set_value(name_id,"TuningConfigCase")
	check(full.engine.save_restart_settings(directory)==OK, "Restart-only settings save to an explicit engine override config")
	config.load(directory.path_join("override.cfg"))
	check(config.get_value("application","config/name")=="TuningConfigCase" and config.get_value("unrelated","keep")==123, "Saved restart config contains edits and preserves unrelated settings")
	check(full.engine.clear_restart_settings(directory)==OK, "Restart overrides can be cleared")
	config.clear()
	config.load(directory.path_join("override.cfg"))
	check(not config.has_section_key("application","config/name") and config.get_value("unrelated","keep")==123, "Clear only removes keys owned by the tuning tool")
	full.reset_value(name_id)
	var angular_id: String = full.find_id("player","rotation")
	tuning.set_panel_open(false)
	check(full.set_value(angular_id,0.4), "Native one-shot rotation edits are accepted")
	await frames(3)
	check(is_equal_approx(arena.player.rotation,0.4), "Rigid-body state edits pass through physics state interface")
	arena.player.request_debug_state("position",Vector2(900,500))
	# 复位取消旧请求的断言需使用安全点，不能在新竖板轴心量碰撞后的位移。
	var reset_destination: Vector2 = arena.director.maps.definition.player_spawn
	arena.player.reset_body(reset_destination)
	await frames(3)
	check(arena.player.position.distance_to(reset_destination)<2, "Normal reset cancels a stale queued debug move")
	var empty_vectors: Array[Vector2] = []
	check(codec.from_parts([[2,3]],empty_vectors)==[Vector2(2,3)], "Empty typed vector arrays accept structured JSON without type errors")
	check(codec.from_parts(["wrong"],PackedFloat32Array())==null, "Malformed packed arrays reject string components")
	arena.director.finish(false)
	tuning.set_panel_open(true)
	tuning.panel._full_view.search.grab_focus()
	var before_typing: int=arena.director._run_revision
	var key:=InputEventKey.new()
	key.pressed=true
	key.keycode=KEY_R
	arena._input(key)
	check(arena.director._run_revision==before_typing, "Searching properties during defeat does not treat R as restart")
	arena.queue_free()
	await frames(3)
	check(Engine.physics_ticks_per_second == ticks, "Leaving the tuner restores global engine settings")
	for project_first in [true,false]:
		var next = load("res://scenes/roguelite/tuning_run.tscn").instantiate()
		root.add_child(next)
		var inspector=next.live_tuning.full
		var project_id: String=inspector.find_id("project","physics/common/physics_ticks_per_second")
		var engine_id: String=inspector.find_id("engine","physics_ticks_per_second")
		inspector.set_value(project_id if project_first else engine_id,120)
		inspector.set_value(engine_id if project_first else project_id,240)
		check(inspector.current_value(project_id)==240 and inspector.current_value(engine_id)==240, "Engine/project aliases share one effective value")
		next.queue_free()
		await frames(3)
		check(Engine.physics_ticks_per_second==ticks, "Both alias edit orders restore the original engine tick rate on exit")
	print("FULL TUNING CHECKS PASSED: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
